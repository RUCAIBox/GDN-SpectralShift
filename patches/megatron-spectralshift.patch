+class _FusedSplitLinearFunc(torch.autograd.Function):
+    """Fuse split projections without retaining a materialized fused weight.
+
+    ``torch.nn.functional.linear(input, torch.cat(weights))`` saves the newly
+    concatenated weight for backward.  At formal-model scale that leaves one
+    extra fused projection weight live per GDN layer and consumes the CUDA
+    headroom needed by NCCL.  This function instead saves references to the
+    owning weights and reconstructs the fused weight during backward.
+
+    Under Megatron DDP, gradients are accumulated directly into ``main_grad``
+    and dtype-compatible dummy tensors are returned so the standard parameter
+    AccumulateGrad/DDP hooks still launch gradient buckets.  Standalone callers
+    without ``main_grad`` receive ordinary autograd gradients.
+    """
+
+    @staticmethod
+    def forward(ctx, inputs, num_weights, *parameters):
+        weights = parameters[:num_weights]
+        biases = parameters[num_weights:]
+        fused_weight = torch.cat(weights, dim=0)
+        fused_bias = torch.cat(biases, dim=0) if biases else None
+
+        ctx.num_weights = num_weights
+        ctx.has_bias = bool(biases)
+        ctx.weight_splits = tuple(weight.shape[0] for weight in weights)
+        ctx.save_for_backward(inputs, *weights, *biases)
+        return torch.nn.functional.linear(inputs, fused_weight, fused_bias)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        inputs = ctx.saved_tensors[0]
+        weights = ctx.saved_tensors[1 : 1 + ctx.num_weights]
+        biases = ctx.saved_tensors[1 + ctx.num_weights :]
+        fused_weight = torch.cat(weights, dim=0)
+
+        grad_output_2d = grad_output.reshape(-1, grad_output.shape[-1])
+        # The formal CP layout can expose grad_output as [tokens, 1, output].
+        # Calling matmul on that rank-3 tensor makes PyTorch broadcast the
+        # weight and launch a tokens-way stride-zero bmm.  This is one GEMM
+        # mathematically; flatten the leading dimensions explicitly and then
+        # restore the input shape.
+        grad_inputs = grad_output_2d.matmul(fused_weight).reshape_as(inputs)
+        inputs_2d = inputs.reshape(-1, inputs.shape[-1])
+        grad_fused_weight = grad_output_2d.t().matmul(inputs_2d)
+        grad_weights = grad_fused_weight.split(ctx.weight_splits, dim=0)
+
+        grad_biases = ()
+        if ctx.has_bias:
+            grad_fused_bias = grad_output_2d.sum(dim=0)
+            grad_biases = grad_fused_bias.split(ctx.weight_splits, dim=0)
+
+        parameter_grads = []
+        for parameter, parameter_grad in zip(
+            (*weights, *biases), (*grad_weights, *grad_biases)
+        ):
+            main_grad = getattr(parameter, "main_grad", None)
+            if isinstance(main_grad, torch.Tensor):
+                main_grad.add_(parameter_grad)
+                parameter.grad_added_to_main_grad = True
+                if getattr(parameter, "zero_out_wgrad", False):
+                    dummy_grad = torch.zeros_like(parameter)
+                else:
+                    dummy_grad = torch.empty_like(parameter)
+                parameter_grads.append(dummy_grad)
+            else:
+                parameter_grads.append(parameter_grad)
+
+        return (grad_inputs, None, *parameter_grads)
+
+class _FusedSplitLinearBoundary(torch.nn.Module):
+    """Parameterless execution boundary for the six split GDN input projections."""
+
+    def __init__(self, projections):
+        super().__init__()
+        projections = tuple(projections)
