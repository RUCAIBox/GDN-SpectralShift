+            raise ValueError("Fused split GDN boundary requires at least one projection.")
+        object.__setattr__(self, "_projection_refs", projections)
+
+    def get_extra_ddp_param_gather_params(self):
+        params = []
+        for projection in self._projection_refs:
+            params.append(projection.weight)
+            bias = getattr(projection, "bias", None)
+            if bias is not None and bias.numel() != 0:
+                params.append(bias)
+        return tuple(params)
+
+    def forward(self, inputs):
+        weights = [projection.weight for projection in self._projection_refs]
+        biases = [
+            None
+            if getattr(projection, "bias", None) is None or projection.bias.numel() == 0
+            else projection.bias
+            for projection in self._projection_refs
+        ]
+        if any(bias is not None for bias in biases) and not all(
+            bias is not None for bias in biases
+        ):
+            raise RuntimeError(
+                "Split GDN fused-forward expects either all split projections to have bias "
+                "or none of them."
+            )
+        fused_output_size = sum(weight.shape[0] for weight in weights)
+        fused_bias_size = (
+            sum(bias.shape[0] for bias in biases) if biases[0] is not None else None
+        )
+        if fused_bias_size is not None and fused_bias_size != fused_output_size:
+            raise RuntimeError(
+                "Split GDN fused-forward bias size mismatch: "
+                f"bias=({fused_bias_size},) weight=({fused_output_size}, {weights[0].shape[1]})"
+            )
+        tensor_biases = [] if fused_bias_size is None else biases
+        return _FusedSplitLinearFunc.apply(inputs, len(weights), *weights, *tensor_biases)
 
 
