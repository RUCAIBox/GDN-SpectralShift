+    def _apply_centered_weight_scale_(weight: nn.Parameter, scale: float, mode: str) -> None:
+        """Apply ``W = mean(W) + scale * (W - mean(W))`` in fp32."""
+        scale = float(scale)
+        if scale == 1.0:
+            return
+        if not math.isfinite(scale) or scale < 0.0:
+            raise ValueError(f"GDN centered weight scale must be finite and >= 0, got {scale}")
+
+        weight_fp32 = weight.data.float()
+        if mode == "matrix":
+            center = weight_fp32.mean()
+        elif mode == "row":
+            if weight_fp32.dim() != 2:
+                raise ValueError(
+                    f"GDN row-centered weight scale expects a 2D weight, got {weight_fp32.shape}"
+                )
+            center = weight_fp32.mean(dim=1, keepdim=True)
+        else:
+            raise ValueError(f"GDN centered weight scale mode must be matrix or row, got {mode!r}")
+
+        scaled = center + scale * (weight_fp32 - center)
+        weight.data.copy_(scaled.to(dtype=weight.data.dtype))
