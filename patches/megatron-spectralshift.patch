+++ b/megatron/training/gdn_spectralshift.py
@@ -0,0 +1,110 @@
+# Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: BSD-3-Clause
+# SpectralShift extraction: runtime logic only; no CLI registration or presets.
+
+import math
+import os
+
+from megatron.training.utils import print_rank_0
+
+APPLIED_KEY = 'gdn_len_ext_postinit_applied'
+
+
+def gdn_projection_lr_condition(args, previous=None):
+    """Non-unit GDN projection WEIGHT overrides; otherwise retain the old rule."""
+    multipliers = {
+        '.q_proj.weight': float(getattr(args, 'gdn_lr_mult_q', 1.0)),
+        '.k_proj.weight': float(getattr(args, 'gdn_lr_mult_k', 1.0)),
+        '.v_proj.weight': float(getattr(args, 'gdn_lr_mult_v', 1.0)),
+        '.a_proj.weight': float(getattr(args, 'gdn_lr_mult_alpha', 1.0)),
+        '.b_proj.weight': float(getattr(args, 'gdn_lr_mult_beta', 1.0)),
+    }
+    if any(not math.isfinite(value) or value < 0 for value in multipliers.values()):
+        raise ValueError('GDN projection LR multipliers must be finite and non-negative.')
+    if all(value == 1.0 for value in multipliers.values()):
+        return previous
+
+    def condition(name, parameter):
+        for suffix, multiplier in multipliers.items():
+            if name.endswith(suffix) and multiplier != 1.0:
+                return multiplier
+        return False if previous is None else previous(name, parameter)
+
+    return condition
+
+
+def validate_gdn_spectralshift_runtime(args, model):
+    """Keep the extracted path within the source implementation's runtime scope."""
+    modules = [m for shard in model for m in shard.modules()
+               if m.__class__.__name__ == 'GatedDeltaNet']
+    per_proj_lr = any(float(getattr(args, 'gdn_lr_mult_' + name, 1.0)) != 1.0
+                      for name in ('q', 'k', 'v', 'alpha', 'beta'))
+    centered = float(getattr(args, 'gdn_alpha_weight_scale', 1.0)) != 1.0
+    for module in modules:
+        if (per_proj_lr or centered) and not module.split_in_proj:
+            raise ValueError('SpectralShift weight/LR scaling requires split GDN projections.')
+        if not module.split_in_proj:
+            continue
+        if module.config.fp8:
+            raise ValueError('This SpectralShift patch does not support FP8 split projections.')
+        if any(getattr(args, name, False) for name in
+               ('use_megatron_fsdp', 'use_torch_fsdp2', 'use_custom_fsdp')):
+            raise ValueError('This SpectralShift patch targets MCore DDP, not FSDP.')
+        if centered and getattr(args, 'use_precision_aware_optimizer', False):
+            raise ValueError('This baseline cannot reload precision-aware optimizer master weights.')
+        if not getattr(module.config, 'gdn_fused_split_forward', False):
+            continue
+        param_overlap = getattr(args, 'overlap_param_gather', False)
+        grad_overlap = getattr(args, 'overlap_grad_reduce', False)
+        if param_overlap and not grad_overlap:
+            raise ValueError('Fused split parameter-gather overlap requires gradient-reduce overlap.')
+        if param_overlap or grad_overlap:
+            if (not getattr(args, 'use_distributed_optimizer', False)
+                    or getattr(args, 'num_distributed_optimizer_instances', 1) != 1
+                    or getattr(args, 'delay_wgrad_compute', False)
+                    or getattr(args, 'use_legacy_models', False)):
+                raise ValueError('Fused split overlap requires one MCore distributed optimizer '
+                                 'instance and delay_wgrad_compute=False.')
+
+
+def apply_gdn_spectralshift_postload(args, model, optimizer):
+    """Mutate alpha once after checkpoint loading, then synchronize master weights.
+
+    Preserve optimizer moments. Persist APPLIED_KEY in common checkpoint state.
+    The primitive in GatedDeltaNet preserves Parameter identity and uses FP32.
+    """
+    scale = float(getattr(args, 'gdn_alpha_weight_scale', 1.0))
+    mode = getattr(args, 'gdn_alpha_weight_scale_mode', 'matrix')
+    if scale == 1.0:
+        return
+    if not math.isfinite(scale) or scale < 0 or mode not in ('matrix', 'row'):
+        raise ValueError('Invalid centered alpha weight scale or mode.')
+    if getattr(args, APPLIED_KEY, False):
+        return
+
+    # Compatibility with checkpoints saved before the marker was introduced.
+    load_path = getattr(args, 'load', None)
+    save_path = getattr(args, 'save', None)
+    resume_paths = set()
+    if save_path:
+        resume_paths.update((os.path.realpath(save_path),
+                             os.path.realpath(os.path.join(save_path, 'non_persistent'))))
+    non_persistent = getattr(args, 'non_persistent_global_ckpt_dir', None)
+    if non_persistent:
+        resume_paths.add(os.path.realpath(non_persistent))
+    if load_path and os.path.realpath(load_path) in resume_paths:
+        setattr(args, APPLIED_KEY, True)
+        return
+
+    modified = 0
+    for shard in model:
+        for module in shard.modules():
+            if module.__class__.__name__ == 'GatedDeltaNet':
+                module.apply_split_alpha_weight_scale(alpha_scale=scale, mode=mode)
+                modified += 1
+    if optimizer is not None:
+        optimizer.reload_model_params()
+    # Set on every pipeline rank, including stages with no local GDN layer.
+    setattr(args, APPLIED_KEY, True)
+    print_rank_0(f'[SpectralShift] transformed {modified} local GDN alpha projections; '
+                 f'scale={scale}, mode={mode}')
